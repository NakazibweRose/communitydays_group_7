{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "mood": {
      "type": "string",
      "enum": [
        "Upbeat",
        "Neutral",
        "Low"
      ],
      "title": "Mood today"
    },
    "energy": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "title": "Energy from 0 to 10"
    },
    "reflection": {
      "type": "string",
      "title": "One thing you noticed",
      "minLength": 1,
      "maxLength": 240
    },
    "entity_id": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "entity_id",
    "mood",
    "energy",
    "reflection"
  ]
}
